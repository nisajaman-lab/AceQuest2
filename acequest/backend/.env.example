# Database configuration
# Leave empty or set to sqlite:///./acequest.db to use SQLite locally
# For PostgreSQL: postgresql://username:password@localhost:5432/acequest
DATABASE_URL=sqlite:///./acequest.db

# JWT settings
# Run openssl rand -hex 32 to generate a secure secret key
SECRET_KEY=supersecretkeyreplaceinproduction1234567890abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App settings
DEBUG=True
PORT=8000
HOST=0.0.0.0
